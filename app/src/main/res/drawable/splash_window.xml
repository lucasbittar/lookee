<?xml version="1.0" encoding="utf-8"?>
<!-- Window background at launch: shows the mark the instant the app opens, before the Go
     library and Compose have loaded (a cold start on the Mi Box takes a few seconds). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg" />
    <item
        android:drawable="@drawable/splash_mark"
        android:gravity="center"
        android:width="96dp"
        android:height="96dp" />
</layer-list>
