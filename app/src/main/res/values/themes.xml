<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: Compose draws everything. The dark background avoids a white flash at launch. -->
    <style name="Theme.Lookee" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>
